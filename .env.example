# ==============================================================================
# 聖地コンパス Reborn (Seichi Compass Reborn) 環境変数テンプレート
# ※ 未設定のままでも .local-data/ ローカル永続化 & 国土地理院無料ジオコーダで全機能が動作します
# ==============================================================================

# 1. Neon Serverless PostgreSQL + PostGIS（設定すると自動的に NeonPostgisRepository に切替）
# DATABASE_URL="postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. Better Auth 認証シークレット & OAuth プロバイダ（任意）
BETTER_AUTH_SECRET="replace-with-random-32-char-secret-key"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# X (Twitter) / Google / Apple OAuth（設定したプロバイダのみUIにボタンが表示されます）
# TWITTER_CLIENT_ID=""
# TWITTER_CLIENT_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# APPLE_CLIENT_ID=""
# APPLE_CLIENT_SECRET=""

# 3. Google Places API (New) キー（未設定時は国土地理院 AddressSearch API へ自動フォールバック）
# GOOGLE_MAPS_API_KEY=""

# 4. 開発・運用フラグ（本番環境では "false" に設定）
ALLOW_DEV_ROLE_SWITCH="true"
ENABLE_DEMO_SIMULATOR="true"

# 5. Expo モバイルアプリ（apps/mobile）接続先
EXPO_PUBLIC_API_URL="http://localhost:3000/api"
EXPO_PUBLIC_WEB_ORIGIN="http://localhost:3000"
