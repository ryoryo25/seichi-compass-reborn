{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seichi-compass-api",
  "main": "src/worker.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOW_DEV_ROLE_SWITCH": "false",
    "ENABLE_DEMO_SIMULATOR": "false"
  },
  "r2_buckets": [
    {
      "binding": "ALBUM_BUCKET",
      "bucket_name": "seichi-compass-private-albums"
    }
  ]
}
